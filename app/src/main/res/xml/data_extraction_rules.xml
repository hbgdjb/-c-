<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31+）的备份与换机迁移规则。
  同样排除派生数据，避免把 237MB 的编译器塞进云端备份或换机迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="ndk" />
        <exclude domain="file" path="libs" />
        <exclude domain="file" path="build" />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ndk" />
        <exclude domain="file" path="libs" />
        <exclude domain="file" path="build" />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
